# Postgres connection string (see root docker-compose.yml for local dev)
DATABASE_URL="postgresql://footyfeed:footyfeed@localhost:5432/footy_feed"

# Port the API listens on
PORT=4000

# Origin(s) allowed to call this API (comma-separated), e.g. the web app's URL
CORS_ORIGIN="http://localhost:5173"

# Secret used to sign admin panel JWTs — set a long random value in production
ADMIN_JWT_SECRET="change-me-in-production"

# --- Phase 1 features wired up progressively, not required to boot the API ---

# Firebase Cloud Messaging (web push) — service account JSON, as a single line
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Whisper transcription — currently unused by choice: "What's Been Said"
# search runs entirely on the free title/description/chapter matching in
# routes/search.ts instead (see lib/podcastDiscovery.ts), not real
# transcripts. lib/transcribe.ts is left intact and dormant in case that
# trade-off is revisited later; leave this blank until then.
OPENAI_API_KEY=""

# X (Twitter) API — powers the Social tab poller (lib/socialPoller.ts), which
# checks TWITTER_SOURCE_USERNAMES every 20 min and inserts new tweets as
# untargeted SOCIAL_POST events, deduped by sourceUrl (the tweet permalink).
# Only TWITTER_BEARER_TOKEN is required for polling (read-only, app-level
# auth); the other four are captured for a future posting feature.
TWITTER_BEARER_TOKEN=""
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""

# Comma-separated X usernames to poll, no leading "@". Defaults to just
# centralNRL if unset.
TWITTER_SOURCE_USERNAMES="centralNRL"

# Podcast discovery — powers "What's Been Said" search coverage beyond the
# curated Podcasts page (lib/podcastDiscoveryPoller.ts), by polling shows the
# admin adds via /admin -> Shows (see routes/adminTrackedShows.ts). Both are
# free, no-card catalog-read APIs; either can be left blank to disable that
# platform's polling without breaking the other.

# YouTube Data API v3 key (Google Cloud Console -> Credentials). Free tier:
# 10,000 units/day; this app only ever calls playlistItems.list (1 unit) and
# videos.list (1 unit, batched), never search.list (100 units) — cheap even
# with many tracked channels.
YOUTUBE_API_KEY=""

# Spotify Client Credentials (developer.spotify.com/dashboard -> your app ->
# Settings). Catalog-only, no user login involved, free.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
